# Copy to deploy/.env and fill in. Never commit the real .env.

# --- Server ---------------------------------------------------------------
# Public hostname pointing at this server (A/AAAA record). Use "localhost" to try it locally.
DOMAIN=prompts.example.com

# Generate each with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
AUTH_SECRET=change-me

# --- GitHub login ---------------------------------------------------------
# Create at https://github.com/settings/developers -> OAuth Apps -> New OAuth App
#   Homepage URL:               https://<DOMAIN>
#   Authorization callback URL: https://<DOMAIN>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Who gets in ------------------------------------------------------------
# Require sign-in for every page and API (keeps the library private)
PCHAT_REQUIRE_LOGIN=true
# Comma-separated GitHub usernames allowed to sign in. Everyone else is turned away.
AUTH_ALLOWED_GITHUB_USERS=your-github-username
# Optional: also allow anyone whose provider-reported email is on these domains.
# GitHub doesn't guarantee that email is verified, so prefer usernames for GitHub.
# AUTH_ALLOWED_EMAIL_DOMAINS=yourcompany.com

# --- Branding (runtime: change, then `docker compose up -d`) ----------------
PCHAT_NAME=My Prompt Library
PCHAT_DESCRIPTION=Our team's AI prompt library
PCHAT_COLOR=#6366f1
# PCHAT_THEME_RADIUS=sm          # none | sm | md | lg
# PCHAT_THEME_VARIANT=default    # default | flat | brutal
# PCHAT_LOCALES=en
# PCHAT_DEFAULT_LOCALE=en

# --- Optional: AI search & generation --------------------------------------
# OPENAI_API_KEY=
# PCHAT_FEATURE_AI_SEARCH=true
# PCHAT_FEATURE_AI_GENERATION=true
